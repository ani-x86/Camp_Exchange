{
  "name": "campx-server",
  "version": "0.2.0",
  "description": "CampusXchange (CampX) Express REST API backend — PostgreSQL edition",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/db/migrate.js",
    "students:import": "node src/db/seed/importStudents.js",
    "seed": "node src/db/seed/seed.js",
    "seed:reset": "node src/db/seed/seed.js --reset",
    "db:purge": "node -e \"import('./src/db/repositories/otps.js').then(m=>m.purgeExpiredOtps()).then(n=>console.log('Purged',n,'OTPs')); import('./src/db/repositories/refreshTokens.js').then(m=>m.purgeExpiredRefreshTokens()).then(n=>console.log('Purged',n,'refresh tokens'));\"",
    "test": "node --test src/db/__tests__/db.test.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.3",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
